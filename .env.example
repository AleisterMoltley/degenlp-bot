# Solana RPC (Helius/QuickNode recommended for DLMM)
RPC_URL=https://api.mainnet-beta.solana.com

# Base58 private key — required for live trading + ProofNetwork telemetry
WALLET_PRIVATE_KEY=

# true = no on-chain txs (default)
DRY_RUN=true

# Scan every 60s like the original bot
SCAN_INTERVAL_MS=60000

# Position size per entry (default 0.05 SOL — adjust to your capital)
SOL_DEPLOY=0.05

# DLMM bins below active price (original: 13 bins)
BIN_RANGE=13

# Reverse-engineered thresholds from 0xdP4jw5rr0xg48XGP
MIN_OPPORTUNITY_SCORE=1.0
MIN_VOLUME_TO_TVL=0.55
MIN_FEE_TO_TVL=0.012
MIN_JUPITER_SCORE=70
MIN_PAIR_LIQUIDITY_USD=5000
MAX_PAIR_LIQUIDITY_USD=500000

# Copy decisions from the original public bot feed
MIRROR_ORIGINAL=false
ORIGINAL_CONTRACT=0xdP4jw5rr0xg48XGP

# ProofNetwork telemetry (deploy your own contract first)
PROOFNETWORK_TELEMETRY=false
PROOFNETWORK_CONTRACT=

# Railway / dashboard (set DASHBOARD_PASSWORD in production!)
PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
STATE_FILE=/app/data/.degenlp-state.json